# Copy this file to .env (same folder) and fill it in. .env is gitignored; never commit it.
# Real environment variables override this file. Lines starting with # are comments.

# Where every run writes its data: the snapshot files directly in this folder, plus changelog/ (daily digests
# and state) and an optional companies.txt. Point it at a synced folder (e.g. Google Drive) to share the data.
# Quote paths with spaces. ~ is expanded. Default if unset: ./output (gitignored).
LINKEDIN_OUTPUT_DIR=~/linkedin-data

# Your Member Data Portability token. Optional here: the scripts also look in macOS Keychain and in
# ~/linkedin-feed/.env.txt (see README). Tokens expire after about 60 days.
# LINKEDIN_TOKEN=

# Keychain service name to read the token from (default linkedin-dma-token).
# LINKEDIN_KEYCHAIN_SERVICE=linkedin-dma-token

# Snapshot domains to pull, comma separated. Blank = every domain LinkedIn documents (about 67).
# LINKEDIN_DOMAINS=CONNECTIONS,PROFILE,POSITIONS
